<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The Mac link is a long-lived connection to an external device, so the bridge
         runs as a connectedDevice FGS. dataSync is kept only as a fallback for OEMs
         that reject connectedDevice: since Android 15 a dataSync FGS is capped at
         6 hours per day, and blowing that cap kills the process
         (ForegroundServiceDidNotStopInTimeException). connectedDevice has no cap. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Playback capture (phone audio → Mac) runs through AudioRecord, so it needs
         RECORD_AUDIO and the microphone service type even though no mic is opened. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Prerequisite for the connectedDevice FGS type, and genuinely used: mDNS
         discovery (MdnsDiscovery) browses the LAN over multicast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Answer / hang up the current call from the Mac. Runtime permission; the
         Mac hides those two buttons until it is actually granted, because a
         dead Answer button on an incoming call is worse than none. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Mute and speaker for the current call. Install-time, so those two are
         available whenever the app is — though the dialer that owns the call
         can still put the route back, which CallControl reads back and reports. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- "Ring my phone" buzzes as well as sounds, for a phone left on a soft
         surface where the alarm alone is easy to miss. Normal permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Auto mode: lets the Mac start mirroring/camera without a tap on the phone. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- In-app updates. DroidDock is sideloaded, so nothing else will ever
         offer it a new version. Holding the permission is not enough on its own:
         the user still grants "install unknown apps" for this app, and still
         confirms each install in a system dialog. See UpdateChecker.kt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Tier B (Apps grid): makes launchable apps visible to package queries on
         Android 11+. Deliberately scoped to the LAUNCHER intent rather than
         requesting QUERY_ALL_PACKAGES — the grid only ever shows apps you can
         actually open, so the broad "see every package" permission buys nothing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="droiddock" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- invisible helper: gains focus, reads clipboard, sends, vanishes -->
        <activity
            android:name=".SendClipboardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- "Send to Mac" in the text-selection menu -->
        <activity
            android:name=".ProcessTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/send_to_mac"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Send to Mac" in the share sheet (text) -->
        <activity
            android:name=".ShareTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/send_to_mac"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Send to Mac" in the share sheet (any file — images, videos, docs, etc.) -->
        <activity
            android:name=".ShareFileActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/send_to_mac"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Serves received clipboard images as `content://` URIs, which is the
             only way an image can go on the clipboard: a clip crosses a ~1 MB
             Binder transaction, so it carries a URI and the system grants the
             pasting app a temporary read. Not exported, and scoped by
             file_paths.xml to one cache subdirectory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

        <!-- screen mirroring over the app link (MediaProjection → H.264 → WebSocket) -->
        <service
            android:name=".MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|camera|microphone" />

        <activity
            android:name=".MirrorPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".NotifListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Where PackageInstaller reports a session's status. Not exported:
             the only sender is the system, replying to a PendingIntent this app
             created. -->
        <receiver android:name=".UpdateInstallReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.droiddock.app.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Stop button on the ringing notification. Not exported: the only
             sender is a same-package PendingIntent this app created, so nothing
             else can silence a ring it did not start. -->
        <receiver android:name=".RingStopReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.droiddock.app.RING_STOP" />
            </intent-filter>
        </receiver>

        <receiver android:name=".CallReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Opt-in, and only ever used for `lockNow()` — see LockAdmin.kt for
             why the Lock button needs a route that doesn't go through the
             accessibility service. `exported="true"` plus the BIND_DEVICE_ADMIN
             permission is the required shape: the system is the only caller,
             and that permission is what stops anyone else binding it. -->
        <receiver
            android:name=".LockAdminReceiver"
            android:exported="true"
            android:label="@string/admin_label"
            android:description="@string/admin_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Optional auto clipboard capture (phone → Mac). Off until the user enables it. -->
        <service
            android:name=".ClipAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Second of the reference's two tiles: drop or restore the Mac link
             without opening the app. -->
        <!-- Revoke the accessibility service without digging through Settings.
             It can only turn itself off; turning it on stays Settings-only. -->
        <service
            android:name=".A11yTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/a11y_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".ConnectionTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/conn_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen widget. Exported because the launcher (a different
             process) both hosts it and delivers its click broadcasts; the
             custom widget actions are same-package PendingIntents, so nothing
             else can trigger them. -->
        <receiver
            android:name=".DockWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dock_info" />
        </receiver>

        <service
            android:name=".ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
