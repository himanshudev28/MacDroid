<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). The "droiddock" prefs file holds the Mac link token and TLS pin;
     neither may leave the phone through cloud backup or device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="droiddock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="droiddock.xml" />
    </device-transfer>
</data-extraction-rules>
