<resources>
    <string name="app_name">DroidDock</string>
    <string name="send_to_mac">Send to Mac</string>
    <string name="tile_label">Send to Mac</string>
    <!-- This is the row you see in Settings › Accessibility, and the description
         is the text you read when deciding to grant it. It named only the
         clipboard while the same service also drives every Mac→phone gesture,
         and claimed "no screen content is read" while the manifest requests
         canRetrieveWindowContent="true" (needed to find the focused text field
         so the Mac can type into it). Consent text has to match what the
         service actually asks for. -->
    <string name="a11y_label">DroidDock — Clipboard &amp; Screen Control</string>
    <string name="a11y_desc">Powers three things for your paired Mac: sending text you copy on this phone, letting the Mac tap, swipe and type on this screen while mirroring, and the Mac\'s Lock button. To type from the Mac it reads the text field you have focused. Everything else — mirroring, file transfer, notifications, photos, calls — keeps working with this off.</string>
    <string name="admin_label">DroidDock screen lock</string>
    <string name="admin_desc">Lets your Mac lock this phone\'s screen without accessibility access being on. Screen lock is the only admin power DroidDock requests.</string>
