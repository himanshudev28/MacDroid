  "identifier": "default",
  "description": "Capability for the main window and the mirror pop-out window",
  "windows": ["main", "mirror"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "notification:default",
    "dialog:default"
  ]
