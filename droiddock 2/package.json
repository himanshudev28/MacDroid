{
  "name": "droiddock",
  "version": "0.5.0",
  "description": "Personal Android <-> Mac bridge. Phase 1: USB via ADB (device info, files, screenshots, screen mirror).",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.0.0",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.droiddock.local",
    "productName": "DroidDock",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "identity": null,
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ]
    }
  }
}